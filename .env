# Tracked project configuration, not a secrets file.
#
# This file is committed on purpose: docker-compose.yml gives both Kokoro
# services a profile, so without COMPOSE_PROFILES a bare `docker compose up -d`
# starts nothing at all. A `--profile gpu` flag on the command line replaces
# this value.
#
# Never put credentials here. Machine-local overrides belong in `.env.local`,
# which is ignored by git.

# Selects the CPU service for a bare `docker compose up -d`.
COMPOSE_PROFILES=cpu
