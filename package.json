{
  "name": "echo-read-edge",
  "version": "2.1.0",
  "description": "Chrome extension that reads web pages aloud with word-level highlighting and a local vocabulary list, with no account and no backend.",
  "license": "Apache-2.0",
  "author": "EchoRead Edge contributors",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "kokoro": "./scripts/start-kokoro.sh",
    "dev": "yarn build:dev && yarn watch",
    "build": "yarn build:main && yarn build:content",
    "build:dev": "yarn build:main:dev && yarn build:content:dev",
    "build:main": "vite build",
    "build:main:dev": "vite build --mode development",
    "build:content": "BUILD_TARGET=content vite build",
    "build:content:dev": "BUILD_TARGET=content vite build --mode development",
    "watch": "concurrently -n main,content -c blue,green \"yarn watch:main\" \"yarn watch:content\"",
    "watch:main": "vite build --watch --mode development",
    "watch:content": "BUILD_TARGET=content vite build --watch --mode development",
    "lint": "eslint src vite.config.ts vitest.config.ts eslint.config.js --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:zip": "yarn build && cd output && zip -r ../echo-read-edge.zip . -x '*.map'"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@preact/preset-vite": "^2.9.4",
    "@types/chrome": "^0.0.287",
    "@types/node": "^18.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "happy-dom": "^16.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
